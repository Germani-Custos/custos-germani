VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_VERBOSE_LOGS=false

# Somente servidor Vercel/Node; NUNCA publicar em runtime-config.js ou usar VITE_*.
# Habilitar apenas após configurar e verificar o ambiente administrativo.
CADASTRO_MESTRE_EXECUTION_ENABLED=false
# Único usuário inicialmente autorizado, confirmado por SELECT no Supabase Auth.
CADASTRO_MESTRE_EXECUTION_ADMIN_IDS=14f1b3ff-0b22-495b-a1c3-9aebae13dc36
CADASTRO_MESTRE_APP_ORIGIN=https://custos-germani.vercel.app
CADASTRO_MESTRE_DATABASE_URL=
# CA PEM opcional para verificação TLS; não desabilitar verificação de certificado.
CADASTRO_MESTRE_DATABASE_CA=
CADASTRO_MESTRE_STORAGE_SECRET_KEY=
# Bucket privado existente, sem políticas públicas de leitura/escrita.
# Nome recomendado; o bucket ainda precisa ser criado/configurado pelo administrador.
CADASTRO_MESTRE_SNAPSHOT_BUCKET=cadastro-mestre-snapshots
